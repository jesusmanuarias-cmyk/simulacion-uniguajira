#campus-ui { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(236, 242, 249); font-size: 15px; -unity-font-style: normal; }
.overview, .explore { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.surface { background-color: rgb(15, 23, 37); border-width: 1px; border-color: rgba(157, 181, 211, 0.20); border-radius: 14px; }
.row { flex-direction: row; align-items: center; }
.header { position: absolute; top: 18px; left: 20px; right: 20px; height: 76px; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 22px; }
.brand { flex-shrink: 0; }
.monogram { width: 42px; height: 42px; border-radius: 12px; background-color: rgb(90, 221, 192); color: rgb(12, 33, 37); -unity-font-style: bold; font-size: 25px; -unity-text-align: middle-center; margin-right: 14px; }
.brand-title { font-size: 23px; -unity-font-style: bold; margin: 0; padding: 0; }
.eyebrow { font-size: 12px; color: rgb(155, 173, 197); -unity-font-style: bold; margin: 0; padding: 0; letter-spacing: 0.8px; }
.brand-text > .eyebrow { margin-top: 3px; }
.header-right { flex-shrink: 0; }
.badge { border-width: 1px; border-color: rgb(56, 73, 96); border-radius: 6px; color: rgb(177, 194, 216); font-size: 12px; padding: 7px 10px; margin-right: 26px; }
.header-clock { align-items: flex-end; }
.visibility-button { height: 32px; margin-right: 18px; font-size: 12px; }
.restore-interface { position: absolute; left: 20px; top: 20px; height: 32px; padding-left: 12px; padding-right: 12px; font-size: 12px; background-color: rgb(15, 23, 37); color: rgb(124, 234, 209); }
.clock { font-size: 29px; -unity-font-style: bold; margin: 0; padding: 0; }
.sidebar { position: absolute; top: 108px; bottom: 22px; left: 20px; width: 300px; overflow: hidden; }
.panel-heading { flex-direction: row; justify-content: space-between; align-items: center; padding: 20px 18px 10px 18px; }
.section-title { font-size: 16px; -unity-font-style: bold; margin: 0; padding: 0; }
.live-state { font-size: 12px; -unity-font-style: bold; color: rgb(99, 227, 192); background-color: rgba(70, 206, 169, 0.12); padding: 5px 7px; border-radius: 5px; }
.live-state.paused { color: rgb(247, 199, 116); background-color: rgba(247, 199, 116, 0.1); }
.stats { padding: 0 18px 17px 18px; }
.total-row { margin-bottom: 12px; }
.total { font-size: 46px; -unity-font-style: bold; margin: 0; padding: 0; }
.total-caption { font-size: 12px; margin-left: 12px; white-space: normal; }
.muted { color: rgb(158, 177, 201); }
.stat-row { height: 25px; }
.dot { width: 7px; height: 7px; border-radius: 4px; padding: 0; margin: 0 10px 0 0; }
.student { background-color: rgb(100, 211, 199); }
.teacher { background-color: rgb(162, 159, 249); }
.admin { background-color: rgb(246, 195, 121); }
.stat-name { flex-grow: 1; font-size: 13px; margin: 0; padding: 0; color: rgb(182, 197, 217); }
.stat-value { font-size: 14px; -unity-font-style: bold; margin: 0; padding: 0; }
Button { height: 37px; margin: 0; padding: 0 12px; color: rgb(222, 232, 246); background-image: none; background-color: rgb(32, 45, 65); border-width: 1px; border-color: rgb(51, 67, 90); border-radius: 8px; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
Button:hover { background-color: rgb(46, 65, 87); border-color: rgb(102, 134, 160); }
Button:active { background-color: rgb(65, 87, 108); }
Button:focus { border-color: rgb(103, 222, 197); }
.tabs { padding: 0 18px; border-bottom-width: 1px; border-bottom-color: rgb(40, 54, 73); }
.tab { flex-grow: 1; height: 36px; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; border-radius: 0; color: rgb(145, 163, 187); }
.tab.selected { border-bottom-color: rgb(100, 222, 194); color: rgb(110, 232, 205); }
.panel-scroll { flex-grow: 1; flex-shrink: 1; }
.panel-scroll .unity-scroller--vertical { width: 8px; margin-right: 4px; }
.panel-scroll .unity-scroller__low-button, .panel-scroll .unity-scroller__high-button { display: none; }
.panel-scroll .unity-base-slider__tracker { background-color: rgb(24, 37, 55); border-width: 0; }
.panel-scroll .unity-base-slider__dragger { background-color: rgb(63, 84, 108); border-width: 0; border-radius: 4px; }
.tab-content { padding: 18px; }
.segmented { background-color: rgb(8, 16, 29); padding: 4px; border-radius: 9px; margin-top: 9px; }
.segment { flex-grow: 1; height: 33px; background-color: transparent; border-width: 0; border-radius: 6px; color: rgb(159, 179, 204); padding: 0 8px; }
.segment.selected { background-color: rgb(44, 66, 81); color: rgb(124, 234, 209); }
.description { font-size: 12px; white-space: normal; margin: 8px 0 0 0; padding: 0; }
.field-heading { margin-top: 19px; }
.speed { margin: 9px 0 15px 0; height: 38px; }
.unity-base-popup-field__input { background-color: rgb(25, 38, 57); border-color: rgb(52, 70, 94); border-width: 1px; border-radius: 8px; padding-left: 11px; color: rgb(230, 239, 249); font-size: 14px; }
.unity-base-popup-field__text { color: rgb(230, 239, 249); }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(160, 186, 211); }
.full { width: 100%; }
.secondary { background-color: rgb(29, 42, 61); margin-top: 9px; }
.primary { background-color: rgb(91, 222, 193); border-color: rgb(91, 222, 193); color: rgb(10, 37, 37); font-size: 12px; height: 40px; }
.primary:hover { background-color: rgb(135, 241, 216); color: rgb(10, 37, 37); border-color: rgb(135, 241, 216); }
.data-note { background-color: rgba(225, 172, 78, 0.08); border-left-width: 2px; border-left-color: rgb(222, 176, 100); padding: 10px; margin-top: 18px; border-radius: 5px; }
.note-title { font-size: 12px; color: rgb(238, 198, 133); -unity-font-style: bold; margin: 0; padding: 0; }
.note-body { font-size: 12px; white-space: normal; color: rgb(190, 180, 160); margin: 4px 0 0 0; padding: 0; }
.panel-footer { flex-shrink: 0; padding: 14px 18px; border-top-width: 1px; border-top-color: rgb(40, 54, 73); }
.footer-note { color: rgb(226, 190, 132); font-size: 12px; margin: 0 0 10px 0; padding: 0; white-space: normal; }
.export-row { margin-top: 8px; }
.quiet { background-color: transparent; border-color: transparent; color: rgb(171, 192, 215); height: 30px; font-size: 12px; flex-grow: 1; }
.quiet:hover { background-color: rgb(34, 50, 70); }
.room-picker { margin-top: 9px; }
.room-arrow { width: 36px; font-size: 23px; padding: 0; }
.room-button { flex-grow: 1; margin: 0 6px; }
.world-caption { position: absolute; top: 108px; right: 20px; padding: 13px 17px; }
.context-value { font-size: 14px; margin: 5px 0 1px 0; padding: 0; }
.world-caption > .muted { font-size: 12px; margin: 0; padding: 0; }
.timeline { position: absolute; bottom: 22px; left: 336px; right: 20px; height: 110px; padding: 13px 18px 9px 18px; }
.timeline-heading { height: 32px; }
.pause { min-width: 94px; height: 31px; color: rgb(118, 234, 207); background-color: rgb(28, 55, 58); border-color: rgb(45, 82, 81); }
.timeline-title { margin-left: 14px; font-size: 14px; -unity-font-style: bold; }
.status { flex-grow: 1; flex-shrink: 1; font-size: 12px; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-right; margin-left: 12px; }
.time-slider { height: 25px; margin: 6px 0 0 0; }
.time-slider .unity-base-slider__tracker { height: 4px; background-color: rgb(55, 75, 98); border-radius: 2px; }
.time-slider .unity-base-slider__dragger { width: 13px; height: 13px; margin-top: -5px; background-color: rgb(103, 230, 200); border-radius: 7px; border-width: 2px; border-color: rgb(163, 255, 230); }
.time-slider .unity-base-slider__dragger-border { border-width: 0; }
.ticks { justify-content: space-between; margin-top: 0; }
.ticks > Label { font-size: 12px; margin: 0; padding: 0; }
.camera-hint { position: absolute; bottom: 141px; left: 342px; color: rgb(244, 248, 255); background-color: rgba(14, 23, 37, 0.83); font-size: 12px; padding: 6px 10px; border-radius: 6px; }
.explore-card { position: absolute; top: 20px; left: 20px; padding: 16px 20px; }
.explore-card > .brand-title { margin-top: 4px; }
.explore-help { position: absolute; bottom: 20px; left: 20px; padding: 14px 20px; }
.help-line { font-size: 14px; margin: 0 0 5px 0; }
.explore-help > .muted { font-size: 12px; }
.interaction { font-size: 13px; color: rgb(117, 235, 204); margin: 5px 0 0 0; }
.crosshair { position: absolute; top: 50%; left: 50%; margin: -12px 0 0 -8px; padding: 0; font-size: 20px; color: rgba(255,255,255,0.8); }
.compact .sidebar { width: 270px; }
.compact .timeline { left: 306px; }
.compact .camera-hint { left: 312px; }
.compact .status { display: none; }
.compact .brand-title { font-size: 21px; }
.compact .badge { display: none; }
.short .header { top: 12px; height: 66px; }
.short .sidebar { top: 90px; bottom: 14px; }
.short .world-caption { top: 90px; }
.short .panel-heading { padding-top: 14px; }
.short .total { font-size: 35px; }
.short .stats { padding-bottom: 10px; }
.short .total-row { margin-bottom: 5px; }
.short .panel-footer { padding-top: 10px; padding-bottom: 10px; }
.short .timeline { bottom: 14px; }
.short .camera-hint { bottom: 132px; }
.short .tab-content { padding-top: 12px; padding-bottom: 12px; }
.short .field-heading { margin-top: 12px; }
.short .stat-row { height: 22px; }
.short .speed { margin-top: 6px; margin-bottom: 6px; }


